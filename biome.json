{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/public",
      "!!**/src/client/shared/shadcn",
      "!!**/src/routeTree.gen.ts",
      "!!**/prototype",
      "!!**/.agents",
      "!!**/dist",
      "!!**/.tanstack",
      "!!**/skills-lock.json",
      "!!**/.cta.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 100,
      "quoteStyle": "double"
    }
  },
  "tailwind": {
    "stylesheet": "./src/client/styles/global.css",
    "mergeFunctions": ["cn"],
    "variantFunctions": ["cva"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "tailwind": "recommended",
      "tanstackQuery": "recommended"
    },
    "rules": {
      "style": {
        "useImportType": "error"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      }
    }
  }
}
